{
  "label": "Wylon H3 · Text to video",
  "order": 60,
  "description": "Wylon H3 video, fixed MiniMax-H3. Text and optional first/last frames; 5–15 seconds, 768p. Submits an async task and waits for the result.",
  "result": {
    "type": "ui_save_url",
    "node": "2"
  },
  "inputs": {
    "1": {
      "prompt": {
        "from": "main_prompt",
        "required": true,
        "error": "Enter a video prompt."
      },
      "duration": {
        "from": "option:duration_s",
        "cast": "int"
      },
      "ratio": {
        "from": "option:aspect_ratio",
        "default": "16:9"
      },
      "resolution": {
        "from": "literal:768p"
      },
      "seed": {
        "from": "option:seed",
        "default": "random_int31",
        "cast": "int"
      }
    }
  }
}
