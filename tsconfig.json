{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "rootDir": "web_src",
    "outDir": "web",
    "skipLibCheck": true,
    "noEmitOnError": true,
    "declaration": false
  },
  "include": [
    "web_src/**/*.ts"
  ]
}
